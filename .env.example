# Cổng chạy ứng dụng Backend
PORT=3001

# ID của Google Sheet cơ sở dữ liệu
SHEET_ID=your_google_sheet_id_here

# Nội dung JSON Service Account kết nối Google Sheets (Minified trên 1 dòng)
GOOGLE_SERVICE_ACCOUNT_JSON_SHEETS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Nội dung JSON Service Account kết nối Firebase Admin SDK (Minified trên 1 dòng)
GOOGLE_SERVICE_ACCOUNT_JSON_FIREBASE={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Thông tin OAuth2 kết nối Google Drive (Minified trên 1 dòng)
GOOGLE_DRIVE_OAUTH_CREDENTIALS={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["http://localhost"]}}
GOOGLE_DRIVE_OAUTH_TOKEN={"access_token":"...","refresh_token":"...","scope":"https://www.googleapis.com/auth/drive","token_type":"Bearer"}
GOOGLE_DRIVE_FOLDER_ID=your_optional_folder_id_here

# Cấu hình gửi email nhắc việc qua Gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_here
EMAIL_FROM="Student Tracker" <your_email@gmail.com>

# CORS Origins (phân tách bởi dấu phẩy nếu có nhiều domain)
CORS_ORIGINS=......
